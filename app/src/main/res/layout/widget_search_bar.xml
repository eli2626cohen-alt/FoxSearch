<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@drawable/bg_widget_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/ivWidgetSearchIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_search" />

    <TextView
        android:id="@+id/tvWidgetSearchHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/search_hint"
        android:textColor="#3C4043"
        android:textSize="14sp" />

    <!-- Al tocar el badge FOX cambia el estilo del widget (Blanco / Oscuro / Translúcido) -->
    <TextView
        android:id="@+id/tvWidgetBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_badge"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:text="FOX"
        android:textColor="#1A73E8"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</LinearLayout>
